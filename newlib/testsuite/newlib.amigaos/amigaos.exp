# AmigaOS-specific runtime tests.

if { ![istarget m68k-*-amigaos*] } {
    return
}

load_lib passfail.exp

set thread_tests [list lock-nomem.c reent-thread.c]
newlib_pass_fail_all -x $thread_tests

# These test the locks and the reents of a program with threads, which are
# in newlib-threads.o.  -pthread would link it, and libpthread too, which
# the tests have no use for.
foreach test $thread_tests {
    set driver "$tmpdir/[file rootname $test].x"
    set comp_output [newlib_target_compile "$srcdir/$subdir/$test" "$driver" \
			 "executable" "ldflags=-l:newlib-threads.o"]
    if { $comp_output != "" } {
	fail "$subdir/$test compilation"
	unresolved "$subdir/$test execution"
    } else {
	pass "$subdir/$test compilation"
	set status [lindex [newlib_load $driver ""] 0]
	$status "$subdir/$test execution"
    }
}
