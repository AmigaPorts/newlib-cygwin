# AmigaOS-specific runtime tests.

if { ![istarget m68k-*-amigaos*] } {
    return
}

load_lib passfail.exp

newlib_pass_fail_all -x [list lock-nomem.c]

# lock-nomem.c tests the locks of a program with threads, which are in
# newlib-threads.o.  -pthread would link it, and libpthread too, which the
# test has no use for.
set driver "$tmpdir/lock-nomem.x"
set comp_output [newlib_target_compile "$srcdir/$subdir/lock-nomem.c" "$driver" \
		     "executable" "ldflags=-l:newlib-threads.o"]
if { $comp_output != "" } {
    fail "$subdir/lock-nomem.c compilation"
    unresolved "$subdir/lock-nomem.c execution"
} else {
    pass "$subdir/lock-nomem.c compilation"
    set status [lindex [newlib_load $driver ""] 0]
    $status "$subdir/lock-nomem.c execution"
}
